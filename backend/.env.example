# ─── Django ──────────────────────────────────────────────────────
SECRET_KEY=your-super-secret-django-key-change-this-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ─── Database (PostgreSQL) ───────────────────────────────────────
DB_ENGINE=django.db.backends.postgresql
DB_NAME=fugusau_db
DB_USER=fugusau_user
DB_PASSWORD=fugusau_pass
DB_HOST=localhost
DB_PORT=5432

# ─── Redis ───────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── JWT Auth ────────────────────────────────────────────────────
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# ─── AWS S3 Storage ──────────────────────────────────────────────
USE_S3=False
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_STORAGE_BUCKET_NAME=fugusau-portal
AWS_S3_REGION_NAME=us-east-1

# ─── Cloudinary (Alternative to S3) ─────────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ─── Paystack Payment ────────────────────────────────────────────
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key
PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key
PAYSTACK_BASE_URL=https://api.paystack.co

# ─── Remita Payment ──────────────────────────────────────────────
REMITA_API_KEY=your_remita_api_key
REMITA_MERCHANT_ID=your_merchant_id
REMITA_BASE_URL=https://remitademo.net/remita/exapp/api/v1/send/

# ─── Email (SendGrid) ────────────────────────────────────────────
SENDGRID_API_KEY=SG.your_sendgrid_api_key
DEFAULT_FROM_EMAIL=noreply@fugusau.edu.ng
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# ─── SMS (Africa's Talking) ──────────────────────────────────────
AT_USERNAME=sandbox
AT_API_KEY=your_africas_talking_api_key
AT_SENDER_ID=FUGUSAU

# ─── AI Assistant Providers ──────────────────────────────────────
GEMINI_API_KEY=your-google-gemini-api-key
AI_PROVIDER=gemini # Choices: gemini, groq, deepseek
GROQ_API_KEY=your-groq-api-key
DEEPSEEK_API_KEY=your-deepseek-api-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key

# ─── WAEC Verification API ───────────────────────────────────────
WAEC_API_KEY=your_waec_api_key
WAEC_API_URL=https://www.waecdirect.org/api/verify/

# ─── NECO Verification API ───────────────────────────────────────
NECO_API_KEY=your_neco_api_key
NECO_API_URL=https://result.neco.gov.ng/api/verify/

# ─── JAMB Verification API ───────────────────────────────────────
JAMB_API_KEY=your_jamb_api_key
JAMB_API_URL=https://www.jamb.gov.ng/api/verify/

# ─── Frontend URL ────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ─── Celery ──────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
