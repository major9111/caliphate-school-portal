# ─── fugusau-gunicorn.service ─────────────────────────────────────────────────
# Copy to: /etc/systemd/system/fugusau-gunicorn.service
# Enable:  sudo systemctl enable --now fugusau-gunicorn
# ──────────────────────────────────────────────────────────────────────────────
[Unit]
Description=FUGUSAU Portal — Gunicorn HTTP server
After=network.target postgresql.service redis.service
Requires=postgresql.service redis.service

[Service]
Type=notify
User=fugusau
Group=fugusau
WorkingDirectory=/opt/fugusau/backend
Environment="DJANGO_SETTINGS_MODULE=fugusau.settings.production"
EnvironmentFile=/opt/fugusau/backend/.env
ExecStart=/opt/fugusau/venv/bin/gunicorn \
          --config /opt/fugusau/backend/gunicorn.conf.py \
          fugusau.wsgi:application
ExecReload=/bin/kill -s HUP $MAINPID
KillMode=mixed
TimeoutStopSec=30
PrivateTmp=true
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
